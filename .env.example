# Copy to /etc/five-o.env (chmod 600, owned by the five-o user) and fill in.
# Generate ADMIN_PASSWORD_HASH with:  bun run scripts/hash-admin-password.ts

NODE_ENV=production

# Where the SQLite database and backups live (must be under ReadWritePaths).
DB_PATH=/var/lib/five-o/five-o.sqlite
BACKUPS_DIR=/var/lib/five-o/backups

# Secrets — generate with e.g.  openssl rand -hex 32
IP_PEPPER=change-me-to-32-random-bytes
COOKIE_SECRET=change-me-to-32-random-bytes

# argon2id hash of the admin password (NOT the password itself).
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=2,p=1$REPLACE$REPLACE
